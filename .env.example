# Copy to .env (mode 600). Never commit .env.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
# One per user who sends mail: SMTP_PASSWORD_<USERNAME upper-cased>
SMTP_PASSWORD_SAM=change-me
APP_TIMEZONE=America/Edmonton
DATABASE_PATH=/data/jobhunter.db
COOKIE_SECURE=true
LOG_LEVEL=INFO
# Reserved for P3 (Claude features), not read yet:
# CLAUDE_CODE_OAUTH_TOKEN=
# Deployment (deploy/docker-compose.yml) and site-specific defaults
JOBHUNTER_HOST=jobs.example.org
JOBHUNTER_SRC=/home/user/job-hunter
PUBLIC_URL=https://jobs.example.org
MAIL_HOST=smtp.example.org
OWN_MAIL_DOMAINS=example.org
